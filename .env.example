# CampusPrint environment variables — NAMES ONLY. Never commit real values.
# Local: copy to .env.local. Vercel: Project -> Settings -> Environment Variables.

# --- Public (inlined into the browser bundle; safe to expose) ---------------
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...). Kept under the ANON_KEY name.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (NEVER prefix with NEXT_PUBLIC_) ----------------------------
# Supabase secret / service-role key. Used only by Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay — not live yet. Leave unset: payment routes answer 503 until set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
