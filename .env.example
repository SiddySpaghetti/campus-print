# CampusPrint environment variables — NAMES ONLY. Never commit real values.
# Local: copy to .env.local. Vercel: Project -> Settings -> Environment Variables.

# --- Public (inlined into the browser bundle; safe to expose) ---------------
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key (sb_publishable_...). Kept under the ANON_KEY name.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (NEVER prefix with NEXT_PUBLIC_) ----------------------------
# Supabase secret / service-role key. Used only by Route Handlers.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay — one set per online shop, each the shop's OWN merchant account, so
# its money goes straight to that shop. The shop's shops.online_payment must also
# be true. A shop with no set is pay-at-counter only. Use Test Mode keys first.
# Sitaram Prints (the original unlabelled set):
RAZORPAY_ENABLED_SHOP_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# K2 Print Store (_1). A further shop repeats all four with _2, and so on:
RAZORPAY_ENABLED_SHOP_ID_1=
RAZORPAY_KEY_ID_1=
RAZORPAY_KEY_SECRET_1=
RAZORPAY_WEBHOOK_SECRET_1=
